# EV Fleet Data Platform
# Local development environment template.
#
# Copy this file to backend/.env for local backend development.
# Never commit real credentials or secrets.

APP_NAME=EV Fleet Data Platform API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me

KAFKA_BROKER=localhost:29092
KAFKA_TOPIC=ev.telemetry.v1
PRODUCER_INTERVAL_SECONDS=2.0

# Replace with a unique random secret of at least 32 characters.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated origins allowed by the API.
CORS_ORIGINS=http://localhost:5173